{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Flipside",
  "version": "0.8.0",
  "identifier": "com.soundtrackgeek.flipside",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flipside",
        "width": 1360,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "backgroundColor": "#0b0b10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGNTM2MDFFNDA5QjNFNkMKUldSc1BwdEFIbUJUTHpwTkoxck1OSHM1VEtCa3pVZXVmejlCQUQ3dk1XeEhvbFprNmlnamRHYjUK",
      "endpoints": [
        "https://github.com/soundtrackgeek/flipside/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
